# paperless-decider configuration - copy to .env and fill in.
# The real .env is git-ignored: never commit credentials to this public repo.

# ---- required -------------------------------------------------------------
# paperless base URL as seen from THIS container (service name / container name).
PAPERLESS_URL=http://CHANGE_ME_paperless:8000
# paperless -> avatar -> Manage Account -> API + Per-User Tokens -> Create token.
# The sidecar can only see and assign what this user can see.
PAPERLESS_API_TOKEN=CHANGE_ME

# Invented shared secret; must match the X-Decider-Token header on the workflow
# action. Generate one: openssl rand -hex 24
DECIDER_SHARED_SECRET=CHANGE_ME

# ---- inference ------------------------------------------------------------
OLLAMA_URL=http://CHANGE_ME_ollama:11434
# A decision model, not a chat model. Needs Ollama >= 0.35.0.
# Use the SMALL tag: tev1:latest is the 4b Q8_0 build (~4.6 GB weights, ~5.5 GB to
# run) and gets its llama-server OOM-killed on a constrained or memory-capped host;
# nimble is ~9.5 GB. tev1:0.8b is 834 MB.
DECIDER_MODEL=tev1:0.8b
DECIDER_TIMEOUT=60
DECIDER_KEEP_ALIVE=15m
DECIDER_WORKERS=1

# ---- what to decide -------------------------------------------------------
# tag, correspondent, document_type, storage_path (comma separated)
DECIDER_FIELDS=tag
DECIDER_MAX_STATE_CHARS=6000
DECIDER_MIN_CONTENT_CHARS=80

# ---- handoff from the paperless title step --------------------------------
# Wait until paperless' own AI action has replaced the filename-derived default
# title, so the title is part of what the decision model reads.
DECIDER_WAIT_FOR_TITLE=true
DECIDER_TITLE_POLL_SECONDS=5
DECIDER_TITLE_POLL_TRIES=12

# ---- confidence policy ----------------------------------------------------
DECIDER_THRESH_SINGLE=0.85
DECIDER_THRESH_TAG=0.80
# /v1/systemone allows 2-26 options; each tag candidate is one forward pass.
DECIDER_MAX_SINGLE_OPTIONS=20
DECIDER_MAX_TAG_OPTIONS=8

# ---- write behaviour ------------------------------------------------------
# Start with true: decides and reports, changes nothing.
DECIDER_DRY_RUN=true
DECIDER_OVERWRITE=false
# Create these two tags in paperless first (Settings -> Manage -> Tags).
DECIDER_REVIEW_TAG=needs-review
DECIDER_DONE_TAG=auto-tagged
# Send documents that matched nothing in your taxonomy to review, not silently blank.
DECIDER_REVIEW_ON_NO_TAGS=true

# ---- http -----------------------------------------------------------------
DECIDER_PORT=8090
DECIDER_LOG_LEVEL=INFO
